# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

export PATH="/Applications/Firefox Developer Edition.app/Contents/MacOS:$PATH"

# RTK (rust token killer) and other user binaries
export PATH="$HOME/.local/bin:$PATH"

# Autocomplete
source $BREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

[ -f $BREW_PREFIX/etc/profile.d/autojump.sh ] && . $BREW_PREFIX/etc/profile.d/autojump.sh

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"
eval "$(pyenv init -)"

# Aliases
alias python=$BREW_PREFIX/bin/python3
alias ll="ls -a"
alias rmr='rm -r'
alias trash='mv "$@" ~/.Trash/'
alias update-all='brew update && brew upgrade && brew upgrade --cask && brew cleanup'

function mkcd () {
  mkdir "$1"
  cd "$1"
}

# Bare `tmux` attaches to the last session instead of creating a new one
function tmux() {
  if [[ $# -eq 0 && -z "$TMUX" ]]; then
    command tmux attach-session 2>/dev/null || command tmux new-session
  else
    command tmux "$@"
  fi
}

source $BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Machine-specific settings and secrets (not tracked in git)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
